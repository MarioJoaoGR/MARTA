digraph formatador {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#3f6ea8"];
  edge [color="#8aa6c4", arrowsize=0.7];
  "#calculate_datum" [fillcolor="#eef3fb" color="#9db6d4"];
  "#color_support" [fillcolor="#eef3fb" color="#9db6d4"];
  "#display";
  "#display_compact_table";
  "#display_line";
  "#display_lines";
  "#display_table";
  "#indentation" [fillcolor="#eef3fb" color="#9db6d4"];
  "#length" [fillcolor="#eef3fb" color="#9db6d4"];
  "#new_line" [fillcolor="#eef3fb" color="#9db6d4"];
  "#parse";
  "#progressbar" [fillcolor="#eef3fb" color="#9db6d4"];
  "#redisplay";
  "#redisplay_line";
  "#redisplay_progressbar";
  "#strip";
  "::ProgressBar#complete?";
  "::ProgressBar#current" [fillcolor="#eef3fb" color="#9db6d4"];
  "::ProgressBar#increment";
  "::ProgressBar#opts" [fillcolor="#eef3fb" color="#9db6d4"];
  "::ProgressBar#total" [fillcolor="#eef3fb" color="#9db6d4"];
  "#display" -> "#parse";
  "#display_compact_table" -> "#calculate_datum";
  "#display_compact_table" -> "#display_line";
  "#display_compact_table" -> "#length";
  "#display_line" -> "#display";
  "#display_line" -> "#new_line";
  "#display_lines" -> "#display_line";
  "#display_table" -> "#display_compact_table";
  "#parse" -> "#color_support";
  "#parse" -> "#indentation";
  "#parse" -> "#strip";
  "#redisplay" -> "#display";
  "#redisplay_line" -> "#new_line";
  "#redisplay_line" -> "#redisplay";
  "#redisplay_progressbar" -> "#new_line";
  "#redisplay_progressbar" -> "#progressbar";
  "#redisplay_progressbar" -> "#redisplay";
  "#strip" -> "#indentation";
  "::ProgressBar#complete?" -> "::ProgressBar#current";
  "::ProgressBar#complete?" -> "::ProgressBar#total";
  "::ProgressBar#increment" -> "::ProgressBar#complete?";
  "::ProgressBar#increment" -> "::ProgressBar#current";
  "::ProgressBar#increment" -> "::ProgressBar#opts";
  "::ProgressBar#increment" -> "::ProgressBar#total";
}